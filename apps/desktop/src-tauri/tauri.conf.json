{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serial Tool",
  "mainBinaryName": "Serial Tool",
  "version": "0.1.0",
  "identifier": "io.github.tom758258.serial-tool",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "Serial Tool",
        "width": 1920,
        "height": 1080,
        "center": true,
        "resizable": true,
        "preventOverflow": true
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "icon": [
      "icons/serial-icon.png",
      "icons/serial-icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}
