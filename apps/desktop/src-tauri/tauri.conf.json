{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serial Tool",
  "mainBinaryName": "Serial Tool",
  "version": "0.1.0",
  "identifier": "io.github.tom758258.serial-tool",

  "app": {
    "windows": [
      {
        "title": "Serial Tool",
        "width": 1440,
        "height": 900,
        "center": true,
        "resizable": true,
        "preventOverflow": true
      }
    ]
  },

  "bundle": {
    "icon": [
      "icons/serial-icon.png",
      "icons/serial-icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      }
    }
  }
}